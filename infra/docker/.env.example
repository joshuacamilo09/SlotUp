# SÓ SEGREDOS. Copie para .env (cp .env.example .env) e troque os valores.
# O .env NÃO vai para o Git. Endereços, portas e regras estão em config/*.env.
# As chaves (JWT e cifra do 2FA) não ficam aqui: são ficheiros em secrets/, gerados por
#   bash gen-secrets.sh
# e partilhados pelas réplicas: o servidor 1 e o servidor 2 usam a MESMA chave do JWT.

# Senhas da base de dados
POSTGRES_PASSWORD=troque-me
AUTH_DB_PASSWORD=troque-me
BOOKING_DB_PASSWORD=troque-me

# Administrador inicial, criado pelo auth-service no arranque (opcional).
# Tem de configurar o 2FA no primeiro login, como qualquer utilizador.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@slotup.pt
ADMIN_PASSWORD=troque-me-por-uma-password-longa

# Dados de exemplo (SÓ desenvolvimento). Rodar com:
#   docker compose exec auth-1 python -m app.seed
#   docker compose exec booking-1 python -m app.seed
SEED_ENABLED=true
# Segredo TOTP fixo dos utilizadores de exemplo. Gerar com:
#   docker compose exec auth-1 python -c "import pyotp; print(pyotp.random_base32())"
SEED_TOTP_SECRET=troque-me
# Senha da utilizadora de exemplo ana@slotup.pt (mínimo 10 caracteres)
SEED_USER_PASSWORD=troque-me-por-uma-password-longa