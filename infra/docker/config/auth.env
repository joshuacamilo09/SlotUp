# Configuração do auth-service: endereços, portas e regras. SEM senhas nem chaves.
# Vai para o Git. As senhas ficam no .env e as chaves na pasta secrets/ (fora do Git).
# No Kubernetes, estes valores estão no ConfigMap auth-config (infra/k8s/configmaps.yaml).

# Base de dados (a senha DB_PASSWORD vem do .env)
DB_HOST=db
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user

# JWT: as duas réplicas leem as MESMAS chaves (secrets/), por isso um token criado
# no servidor 1 é aceite no servidor 2 e no booking
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
JWT_ISSUER=slotup-auth
JWT_AUDIENCE=slotup
ACCESS_TOKEN_MINUTES=30
PRE_AUTH_TOKEN_MINUTES=5

# 2FA
TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key
TOTP_ISSUER=SlotUp

# Bloqueio por tentativas falhadas e validade do token de redefinição
MAX_FAILED_ATTEMPTS=10
LOCK_MINUTES=15
PASSWORD_RESET_MINUTES=30