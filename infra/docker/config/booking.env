# Configuração do booking-service: endereços, portas e regras. SEM senhas nem chaves.
# Vai para o Git. A senha fica no .env e a chave pública do JWT na pasta secrets/.
# No Kubernetes, estes valores estão no ConfigMap booking-config (infra/k8s/configmaps.yaml).

# Base de dados (a senha DB_PASSWORD vem do .env)
DB_HOST=db
DB_PORT=5432
DB_NAME=booking_db
DB_USER=booking_user

# JWT: só a chave PÚBLICA (valida tokens, não os cria). É a mesma do auth.
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
JWT_ISSUER=slotup-auth
JWT_AUDIENCE=slotup

# Outros serviços
SCHEDULING_URL=http://scheduling:8003

# Fuso horário do complexo (os horários de funcionamento estão em hora local)
LOCAL_TIMEZONE=Europe/Lisbon